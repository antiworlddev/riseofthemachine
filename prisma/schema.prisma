generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum OrderStatus {
  RESERVED
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}
enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
}
enum TicketStatus {
  ACTIVE
  VOID
}
enum RegistrationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}
model Event {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  dateLocal String @db.VarChar(10)
  startsAt DateTime? @db.Timestamptz(3)
  timezone String @default("Africa/Lagos")
  venue String?
  salesEnabled Boolean @default(false)
  registrationEnabled Boolean @default(false)
  settingsRevision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  tableInventory TableInventory?
  tiers TicketTier[]
  orders Order[]
  competitions Competition[]
  teams TeamRegistration[]
  teamOptions TeamOption[]
}
model TicketTier {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  code String
  name String
  priceMinor Int
  currency String @default("NGN") @db.VarChar(3)
  capacity Int
  reserved Int @default(0)
  sold Int @default(0)
  active Boolean @default(false)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  parkingPerTable Int?
  lines OrderLine[]
  @@unique([eventId, code])
  @@unique([id, eventId])
}
model Order {
  tableArrivedAt DateTime? @db.Timestamptz(3)
  tableLabel String?
  bookingNote String?
  bookingRevision Int @default(1)
  operationsRevision Int @default(1)
  refund PaymentRefund?
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  idempotencyKey String @unique
  buyerSubject String?
  needsReconciliation Boolean @default(false)
  buyerName String
  buyerEmail String
  status OrderStatus @default(RESERVED)
  totalMinor Int
  currency String @default("NGN") @db.VarChar(3)
  expiresAt DateTime @db.Timestamptz(3)
  paidAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  lines OrderLine[]
  payments PaymentAttempt[]
  @@unique([id, eventId])
  @@index([status, expiresAt])
  @@index([buyerEmail])
  @@index([buyerSubject, createdAt])
}
model OrderLine {
  parkingQuantity Int @default(0)
  parkingPasses ParkingPass[]
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  eventId String @db.Uuid
  tierId String @db.Uuid
  quantity Int
  unitPriceMinor Int
  order Order @relation(fields: [orderId, eventId], references: [id, eventId], onDelete: Restrict)
  tier TicketTier @relation(fields: [tierId, eventId], references: [id, eventId], onDelete: Restrict)
  tickets Ticket[]
  @@unique([orderId, tierId])
}
model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  reference String @unique
  authorizationUrl String?
  initializingAt DateTime? @db.Timestamptz(3)
  domain String @default("test")
  providerTransactionId String? @unique
  amountMinor Int
  currency String @db.VarChar(3)
  status PaymentStatus @default(PENDING)
  verifiedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId])
}
model Ticket {
  id String @id @default(uuid()) @db.Uuid
  orderLineId String @db.Uuid
  ordinal Int
  encryptedToken String?
  tokenHash String @unique @db.VarChar(64)
  status TicketStatus @default(ACTIVE)
  issuedAt DateTime @default(now()) @db.Timestamptz(3)
  line OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  admission Admission?
  @@unique([orderLineId, ordinal])
}
model StaffUser {
  revision Int @default(1)
  eligibilityReviews EligibilitySubmission[]
  refunds PaymentRefund[]
  id String @id @default(uuid()) @db.Uuid
  authSubject String @unique
  email String @unique
  role String
  enabled Boolean @default(false)
  parkingAdmissions ParkingAdmission[]
  admissions Admission[]
  auditLogs AuditLog[]
}
model Admission {
  ticketId String @id @db.Uuid
  staffId String @db.Uuid
  scannedAt DateTime @default(now()) @db.Timestamptz(3)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Restrict)
  @@index([scannedAt])
}
model Representative {
  id String @id @default(uuid()) @db.Uuid
  authSubject String @unique
  name String
  email String @unique
  phone String
  verifiedAt DateTime? @db.Timestamptz(3)
  eligibilitySubmissions EligibilitySubmission[]
  teams TeamRegistration[]
}
model TeamRegistration {
  ownershipRevision Int @default(1)
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  representativeId String @db.Uuid
  teamKey String
  teamName String
  universityName String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  representative Representative @relation(fields: [representativeId], references: [id], onDelete: Restrict)
  rosters SportRoster[]
  option TeamOption @relation(fields: [eventId, teamKey], references: [eventId, key], onDelete: Restrict)
  @@unique([eventId, teamKey])
  @@unique([id, eventId])
  @@index([representativeId])
}
model Competition {
  tournament Tournament?
  eligibilityEnabled Boolean @default(false)
  eligibilityRevision Int @default(1)
  eligibilityRequirements String?
  eligibilityEvidenceRequired Boolean @default(false)
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  sportCode String
  minPlayers Int?
  maxPlayers Int?
  registrationEnabled Boolean @default(false)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  rosters SportRoster[]
  @@unique([eventId, sportCode])
  @@unique([id, eventId])
}
model SportRoster {
  tournamentEntries TournamentEntry[]
  currentEligibilityId String? @unique @db.Uuid
  currentEligibility EligibilitySubmission? @relation("CurrentEligibility",fields:[currentEligibilityId],references:[id],onDelete:Restrict)
  eligibilityHistory EligibilitySubmission[] @relation("EligibilityHistory")
  id String @id @default(uuid()) @db.Uuid
  teamId String @db.Uuid
  competitionId String @db.Uuid
  eventId String @db.Uuid
  status RegistrationStatus @default(DRAFT)
  revision Int @default(1)
  submittedAt DateTime? @db.Timestamptz(3)
  reviewedAt DateTime? @db.Timestamptz(3)
  reviewNote String?
  team TeamRegistration @relation(fields: [teamId, eventId], references: [id, eventId], onDelete: Restrict)
  competition Competition @relation(fields: [competitionId, eventId], references: [id, eventId], onDelete: Restrict)
  members RosterMember[]
  @@unique([teamId, competitionId])
  @@index([status])
}
model RosterMember {
  id String @id @default(uuid()) @db.Uuid
  rosterId String @db.Uuid
  participantKey String
  fullName String
  jerseyNumber Int?
  captain Boolean @default(false)
  roster SportRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  @@unique([rosterId, participantKey])
  @@unique([rosterId, jerseyNumber])
}
model OutboxMessage {
  revision Int @default(1)
  deliveryGeneration Int @default(1)
  deliveryMode String?
  scopeSlug String?
  notificationSnapshot String?
  id String @id @default(uuid()) @db.Uuid
  deduplicationKey String @unique
  kind String
  payload Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  attempts Int @default(0)
  encryptedDeliveryPayload String?
  firstAttemptAt DateTime? @db.Timestamptz(3)
  lockedUntil DateTime? @db.Timestamptz(3)
  leaseToken String? @db.Uuid
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  lastErrorCode String?
  providerMessageId String?
  blocked Boolean @default(false)
  @@index([deliveredAt, createdAt])
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  action String
  entityType String
  entityId String
  metadata Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  actor StaffUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([entityType, entityId, createdAt])
  @@index([createdAt, id])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model TeamOption {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  key String
  name String
  universityName String?
  enabled Boolean @default(false)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registrations TeamRegistration[]
  @@unique([eventId, key])
}
model ApiRateBucket {
  key String @id
  count Int @default(1)
  expiresAt DateTime @db.Timestamptz(3)
  @@index([expiresAt])
}

enum MerchFulfilment {
  PICKUP
  DELIVERY
}
enum MerchFulfilmentStatus {
  PENDING
  READY
  DISPATCHED
  COMPLETED
}
model MerchProduct {
  revision Int @default(1)
  imageUrl String?
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  kind String
  description String
  priceMinor Int
  active Boolean @default(false)
  variants MerchVariant[]
}
model MerchVariant {
  enabled Boolean @default(true)
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  label String
  capacity Int @default(0)
  reserved Int @default(0)
  sold Int @default(0)
  product MerchProduct @relation(fields:[productId],references:[id],onDelete:Restrict)
  lines MerchOrderLine[]
  @@unique([productId,label])
}
model MerchOrder {
  shippingFeeMinor Int @default(0)
  shippingRateId String? @db.Uuid
  shippingSnapshot Json?
  shippingRate ShippingRate? @relation(fields:[shippingRateId],references:[id],onDelete:Restrict)
  operationsRevision Int @default(1)
  refund PaymentRefund?
  id String @id @default(uuid()) @db.Uuid
  eventSlug String
  idempotencyKey String @unique
  requestHash String
  buyerSubject String
  buyerName String
  buyerEmail String
  phone String
  fulfilment MerchFulfilment
  address Json?
  deliveryTerms String?
  status OrderStatus @default(RESERVED)
  needsReconciliation Boolean @default(false)
  totalMinor Int
  currency String @default("NGN")
  expiresAt DateTime @db.Timestamptz(3)
  paidAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  fulfilmentStatus MerchFulfilmentStatus @default(PENDING)
  revision Int @default(1)
  trackingNote String?
  lines MerchOrderLine[]
  payments MerchPayment[]
  @@index([buyerSubject,createdAt])
  @@index([eventSlug,createdAt,id])
  @@index([status,expiresAt])
}
model MerchOrderLine {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  variantId String @db.Uuid
  productName String
  variantLabel String
  quantity Int
  unitPriceMinor Int
  order MerchOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  variant MerchVariant @relation(fields:[variantId],references:[id],onDelete:Restrict)
  @@unique([orderId,variantId])
}
model MerchPayment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  reference String @unique
  authorizationUrl String?
  initializingAt DateTime? @db.Timestamptz(3)
  domain String
  providerTransactionId String? @unique
  amountMinor Int
  currency String
  status PaymentStatus @default(PENDING)
  verifiedAt DateTime? @db.Timestamptz(3)
  order MerchOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
}

model PaymentRefund {
  id String @id @default(uuid()) @db.Uuid
  orderId String? @unique @db.Uuid
  merchOrderId String? @unique @db.Uuid
  reference String @unique
  transactionId String @unique
  domain String
  amountMinor Int
  currency String @default("NGN")
  status String @default("INITIATING")
  providerRefundId String? @unique
  stockBasis String
  reason String
  requestedBy String @db.Uuid
  requestedByStaff StaffUser @relation(fields:[requestedBy],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  order Order? @relation(fields:[orderId],references:[id],onDelete:Restrict)
  merchOrder MerchOrder? @relation(fields:[merchOrderId],references:[id],onDelete:Restrict)
}

model ShippingRate {
  id String @id @default(uuid()) @db.Uuid
  eventSlug String
  state String
  stateKey String
  feeMinor Int
  note String
  enabled Boolean @default(false)
  revision Int @default(1)
  orders MerchOrder[]
  @@unique([eventSlug,stateKey])
}

model TableInventory {
  eventId String @id @db.Uuid
  parkingCapacity Int @default(0)
  parkingReserved Int @default(0)
  parkingSold Int @default(0)
  revision Int @default(1)
  event Event @relation(fields:[eventId],references:[id],onDelete:Restrict)
}
model ParkingPass {
  id String @id @default(uuid()) @db.Uuid
  orderLineId String @db.Uuid
  ordinal Int
  tokenHash String @unique @db.VarChar(64)
  encryptedToken String
  status TicketStatus @default(ACTIVE)
  line OrderLine @relation(fields:[orderLineId],references:[id],onDelete:Restrict)
  admission ParkingAdmission?
  @@unique([orderLineId,ordinal])
}
model ParkingAdmission {
  passId String @id @db.Uuid
  staffId String @db.Uuid
  scannedAt DateTime @default(now()) @db.Timestamptz(3)
  pass ParkingPass @relation(fields:[passId],references:[id],onDelete:Restrict)
  staff StaffUser @relation(fields:[staffId],references:[id],onDelete:Restrict)
}

model EligibilitySubmission {
 id String @id @default(uuid()) @db.Uuid
 rosterId String @db.Uuid
 roster SportRoster @relation("EligibilityHistory",fields:[rosterId],references:[id],onDelete:Restrict)
 currentFor SportRoster? @relation("CurrentEligibility")
 representativeId String @db.Uuid
 representative Representative @relation(fields:[representativeId],references:[id],onDelete:Restrict)
 representativeName String
 representativeEmail String
 policyRevision Int
 requirements String
 evidenceRequired Boolean
 response String
 membersHash String @db.VarChar(64)
 confirmed Boolean
 submittedAt DateTime @default(now()) @db.Timestamptz(3)
 decision String @default("PENDING")
 reviewedAt DateTime? @db.Timestamptz(3)
 reviewedBy String? @db.Uuid
 reviewer StaffUser? @relation(fields:[reviewedBy],references:[id],onDelete:Restrict)
 reviewNote String?
 @@index([rosterId,submittedAt])
}

model Tournament {
 id String @id @default(uuid()) @db.Uuid
 competitionId String @unique @db.Uuid
 competition Competition @relation(fields:[competitionId],references:[id],onDelete:Restrict)
 format String
 scoreLabel String
 rules Json?
 published Boolean @default(false)
 revision Int @default(1)
 drawnAt DateTime? @db.Timestamptz(3)
 entries TournamentEntry[]
 fixtures Fixture[]
}
model TournamentEntry {
 tournamentId String @db.Uuid
 rosterId String @db.Uuid
 tournament Tournament @relation(fields:[tournamentId],references:[id],onDelete:Restrict)
 roster SportRoster @relation(fields:[rosterId],references:[id],onDelete:Restrict)
 teamName String
 drawPosition Int
 homeFixtures Fixture[] @relation("FixtureHome")
 awayFixtures Fixture[] @relation("FixtureAway")
 wins Fixture[] @relation("FixtureWinner")
 @@id([tournamentId,rosterId])
 @@unique([tournamentId,drawPosition])
}
model Fixture {
 id String @id @default(uuid()) @db.Uuid
 tournamentId String @db.Uuid
 tournament Tournament @relation(fields:[tournamentId],references:[id],onDelete:Restrict)
 round Int
 slot Int
 homeRosterId String? @db.Uuid
 awayRosterId String? @db.Uuid
 winnerRosterId String? @db.Uuid
 home TournamentEntry? @relation("FixtureHome",fields:[tournamentId,homeRosterId],references:[tournamentId,rosterId],onDelete:Restrict)
 away TournamentEntry? @relation("FixtureAway",fields:[tournamentId,awayRosterId],references:[tournamentId,rosterId],onDelete:Restrict)
 winner TournamentEntry? @relation("FixtureWinner",fields:[tournamentId,winnerRosterId],references:[tournamentId,rosterId],onDelete:Restrict)
 status String @default("SCHEDULED")
 homeScore Int?
 awayScore Int?
 deciderNote String?
 startsAt DateTime? @db.Timestamptz(3)
 venue String?
 revision Int @default(1)
 nextFixtureId String? @db.Uuid
 nextSide String?
 next Fixture? @relation("Bracket",fields:[nextFixtureId],references:[id],onDelete:Restrict)
 predecessors Fixture[] @relation("Bracket")
 @@unique([tournamentId,round,slot])
 @@unique([nextFixtureId,nextSide])
}

model Subscriber {
 mailjetSyncPending Boolean @default(true)
 mailjetRevision Int @default(1)
 mailjetSyncedAt DateTime? @db.Timestamptz(3)
 mailjetNextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
 mailjetAttempts Int @default(0)
 mailjetLease String? @db.Uuid
 mailjetLockedUntil DateTime? @db.Timestamptz(3)
 mailjetLastError String? @db.VarChar(64)
 mailjetSuppressedAt DateTime? @db.Timestamptz(3)
 id String @id @default(uuid()) @db.Uuid
 email String @unique @db.VarChar(254)
 firstName String @db.VarChar(80)
 waitlistAt DateTime? @db.Timestamptz(3)
 waitlistUnsubscribedAt DateTime? @db.Timestamptz(3)
 newsletterAt DateTime? @db.Timestamptz(3)
 unsubscribedAt DateTime? @db.Timestamptz(3)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 consents SubscriberConsent[]
 @@index([createdAt, id])
}
model SubscriberConsent {
 id String @id @default(uuid()) @db.Uuid
 subscriberId String @db.Uuid
 subscriber Subscriber @relation(fields:[subscriberId],references:[id],onDelete:Cascade)
 action String @db.VarChar(32)
 source String @db.VarChar(32)
 version String @db.VarChar(32)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([subscriberId,createdAt])
}

model MailjetEvent {
 key String @id @db.VarChar(64)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}
