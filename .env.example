# Local development database only; use separate runtime/migration roles for production.
DATABASE_URL=postgresql://rotm:local_only@localhost:5432/rotm
APP_ORIGIN=http://localhost:3000
KALA_EVENT_SLUG=kala-games-2026
KALA_REGISTRATION_ENABLED=false

# Configure a hosted OpenID Connect provider. Leave blank until it exists.
AUTH_ISSUER=
AUTH_AUTHORIZATION_URL=
AUTH_TOKEN_URL=
AUTH_JWKS_URL=
AUTH_CLIENT_ID=
# Optional for public clients; confidential clients use client_secret_post.
# AUTH_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_KEY=
