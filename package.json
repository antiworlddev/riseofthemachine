{
  "name": "rise-of-the-machine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "db:seed": "node --env-file=.env --import tsx scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "jose": "6.2.12",
    "jsqr": "1.4.0",
    "next": "16.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.19.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "effect": "3.20.0",
    "deepmerge-ts": "8.0.0"
  }
}
